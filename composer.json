{
    "name": "decodelabs/metamorph",
    "description": "A flexible framework for content transformations",
    "type": "library",
    "keywords": [
        "render",
        "transform",
        "content"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Tom Wright",
            "email": "tom@inflatablecookie.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "symfony/polyfill-mbstring": "^1.33",

        "decodelabs/archetype": "^0.4",
        "decodelabs/coercion": "^0.3.5",
        "decodelabs/exceptional": "^0.6.3",
        "decodelabs/monarch": "^0.2.1",
        "decodelabs/tagged": "^0.21"
    },
    "require-dev": {
        "decodelabs/chorus": "^0.1",
        "decodelabs/phpstan-decodelabs": "^0.7",

        "soundasleep/html2text": "^2.1",
        "erusev/parsedown": "^1.7.4",
        "michelf/php-markdown": "^2"
    },
    "suggest": {
        "erusev/parsedown": "Add support for Markdown parsing",
        "michelf/php-markdown": "Alternative Markdown parsing provider",
        "soundasleep/html2text": "Better HTML to text conversion"
    },
    "autoload": {
        "psr-4": {
            "DecodeLabs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecodeLabs\\Metamorph\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-develop": "0.8.x-dev"
        },
        "effigy": {
            "exports": [
                "phpstan-extension.neon"
            ]
        },
        "phpstan": {
            "includes": [
                "phpstan-extension.neon"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    }
}
